# Caventia.com environment variables — copy to .env.local and fill in.

# Resend transactional email — used by /api/contact and /api/whitepaper
# Get from https://resend.com — leave blank to log submissions instead.
RESEND_API_KEY=

# Where contact / whitepaper submissions are forwarded.
CONTACT_FORWARD_EMAIL=ashish@caventia.com
RESEND_FROM_EMAIL=Caventia <noreply@caventia.com>

# Calendly link surfaced on whitepaper confirmation + final CTA.
NEXT_PUBLIC_CALENDLY_URL=

# Plausible Analytics — leave blank to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Site origin (used in metadata + OG images)
NEXT_PUBLIC_SITE_URL=https://caventia.com
